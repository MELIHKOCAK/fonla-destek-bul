# BeniFonla — Örnek ortam değişkenleri
# Gerçek anahtarları BURAYA YAZMAYIN. Bu dosya yalnızca anahtar adlarını
# belgelemek içindir ve repoya işlenir. Yerel değerleri `.env.local`
# dosyasına yazın; o dosya `.gitignore` ile hariç tutulur.

# Uygulama meta verisi
# VITE_APP_NAME=BeniFonla
# VITE_APP_ENV=local   # local | development | staging | production

# --- Bu fazda kullanılmıyor ---
# Supabase / Lovable Cloud bu fazda BAĞLANMADI.
# Aşağıdaki anahtarlar yalnızca ileride backend bağlandığında eklenecektir.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # ASLA frontend'e veya repoya yazılmaz

# --- Faz 11.5 Stripe hazırlık (Faz 12'de aktive) ---
# Sandbox-first: sadece _TEST varyantları geliştirme sırasında doldurulur.
# _LIVE varyantları yazılı Stripe + crowdfunding onayından sonra eklenir.
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_API_VERSION=
APP_PUBLIC_URL=

# AI Asistan (Google Gemini)
# Gerçek değerleri BURAYA YAZMAYIN; yalnızca isimleri belgeleyin.
GEMINI_API_KEY=
AI_RATE_LIMIT_HASH_SECRET=
AI_CHAT_ENABLED=false

